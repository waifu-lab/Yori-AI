import type { Preview, Decorator } from '@storybook/sveltekit';
import '../src/app.css';

function cleanupStalePreviewNodes() {
  if (typeof document === 'undefined') return;

  const root = document.getElementById('storybook-root');
  if (root) {
    root.replaceChildren();
  }

  const docsRoot = document.getElementById('storybook-docs');
  if (docsRoot) {
    docsRoot.replaceChildren();
  }

  const keepIds = new Set(['storybook-root', 'storybook-docs']);

  for (const child of Array.from(document.body.children)) {
    const element = child as HTMLElement;
    const tag = element.tagName;

    if (tag === 'SCRIPT' || tag === 'STYLE') continue;
    if (keepIds.has(element.id)) continue;
    if (element.id.startsWith('storybook-')) continue;

    element.remove();
  }
}

const withTheme: Decorator = (Story, context) => {
  cleanupStalePreviewNodes();

  const theme = (context.globals?.theme as string) ?? 'dark';
  document.documentElement.setAttribute('data-theme', theme);

  return Story();
};

const preview: Preview = {
  parameters: {
    docs: {
      story: {
        inline: false,
      },
    },
    backgrounds: {
      default: 'dark',
      values: [
        { name: 'dark', value: '#0f172a' },
        { name: 'light', value: '#f8fafc' },
      ],
    },
    controls: {
      matchers: {
        color: /(background|color)$/i,
        date: /Date$/i,
      },
    },
  },
  globalTypes: {
    theme: {
      name: 'Theme',
      description: 'Global theme',
      defaultValue: 'dark',
      toolbar: {
        icon: 'circlehollow',
        items: [
          { value: 'dark', title: 'Dark' },
          { value: 'light', title: 'Light' },
        ],
      },
    },
  },
  decorators: [withTheme],
};

export default preview;
