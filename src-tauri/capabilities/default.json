{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "live2d-preview"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "store:default",
    "dialog:default"
  ]
}