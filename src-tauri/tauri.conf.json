{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ai-vtuber-launcher",
  "version": "0.0.1",
  "identifier": "com.lumina.dream-whisper.ai-vtuber-launcher",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yori AI Dashboard",
        "width": 1,
        "height": 1,
        "resizable": true,
        "transparent": true,
        "fullscreen": false
      },
      {
        "label": "chat",
        "title": "Yori AI",
        "url": "chat",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "設定",
        "url": "settings",
        "width": 860,
        "height": 600,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      },
      {
        "label": "float-chat",
        "title": "Yori AI",
        "url": "float-chat",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "live2d-preview",
        "title": "Live2D",
        "width": 400,
        "height": 600,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "live2d",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' asset: http://asset.localhost blob: data: http://asset.localhost http://127.0.0.1:* http://localhost:*; media-src 'self' blob: data: http://127.0.0.1:* http://localhost:*; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "C:/**",
            "D:/**",
            "E:/**"
          ],
          "deny": []
        }
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "unsafe-none"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}