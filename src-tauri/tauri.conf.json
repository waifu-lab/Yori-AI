{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ai-vtuber-launcher",
  "version": "0.0.1",
  "identifier": "com.lumina.dream-whisper.ai-vtuber-launcher",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yori AI Dashboard",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "decorations": false,
        "fullscreen": true,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
